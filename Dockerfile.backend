FROM python:3.12.13-slim@sha256:090ba77e2958f6af52a5341f788b50b032dd4ca28377d2893dcf1ecbdfdfe203

WORKDIR /app

# Install deps as root, then drop to non-root for runtime
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source (no secrets — they come in via env_file at runtime)
COPY core/ ./core/
COPY contracts/ ./contracts/
COPY app/__init__.py ./app/
COPY app/sse_broadcaster.py ./app/
COPY app/obs_client.py ./app/
COPY app/reconciliation.py ./app/
COPY app/process_tip.py ./app/
COPY app/stages/ ./app/stages/
COPY app/settings.json ./app/
COPY main.py .
COPY routes/ ./routes/

# Create non-root user and data directory with correct ownership
RUN useradd -r -u 1000 -g 0 appuser && \
    chown -R appuser:0 /app && \
    mkdir -p /data && chown appuser:0 /data && chmod 775 /data

USER 1000

EXPOSE 8000

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
