# ============================================================
# Tip Overlay System — environment config (copy to .env, never commit .env)
# chmod 600 .env after filling in
# ============================================================

# --- Payment gateway (which provider) ---
# omise (default) or stripe. Both accept PromptPay server-side (no client JS).
PAYMENT_GATEWAY=omise

# --- Omise (required when PAYMENT_GATEWAY=omise) ---
# Get from: https://dashboard.omise.co → Settings → Keys
OMISE_SECRET_KEY=skey_test_CHANGEME
# Base64-encoded webhook secret from Omise dashboard → Webhooks → Secret
OMISE_WEBHOOK_SECRET=CHANGEME_BASE64_ENCODED

# --- Stripe (required when PAYMENT_GATEWAY=stripe) ---
# Secret key: dashboard.stripe.com → Developers → API keys (sk_test_ / sk_live_)
STRIPE_SECRET_KEY=sk_test_CHANGEME
# Webhook signing secret: Developers → Webhooks → (your endpoint) → whsec_...
STRIPE_WEBHOOK_SECRET=whsec_CHANGEME

# --- Cloudflare Tunnel (required) ---
# Get from: Cloudflare Zero Trust → Access → Tunnels → your tunnel → token
CLOUDFLARE_TUNNEL_TOKEN=CHANGEME

# --- OBS WebSocket (required) ---
OBS_WS_HOST=host.docker.internal
OBS_WS_PORT=4455
OBS_WS_PASSWORD=CHANGEME

# --- CORS (required) — your public domain, no trailing slash ---
CORS_ORIGIN=https://tip.yourdomain.com

# --- Overlay access token (required) ---
# Random string — paste into OBS browser source URL as ?token=...
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OVERLAY_TOKEN=CHANGEME_RANDOM_TOKEN

# --- Database (optional, defaults to SQLite) ---
DATABASE_URL=sqlite:////data/tips.db
# Postgres example: postgresql://user:pass@host:5432/tips

# --- Timezone ---
TZ=Asia/Bangkok

# --- Debug (NEVER set to true in production) ---
DEBUG=false

# --- Dev test trigger (NEVER set to 1 in production) ---
# When 1, mounts POST /api/dev/test-tip to fire a fake overlay alert with no
# payment. Bypasses signature verify + money record — local development only.
DEV_TEST_TRIGGER=0
